{
  "name": "SAVERS2 SingleRMS",
  "tests": [
    {
      "testName": "Happypath Pass",
      "inputs": {
        "fileName": "happypath-pass.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "approved",
        "reasonsForFailure": null,
        "model": "SAVERS2"
      }
    },
    {
      "testName": "DifferentCountryEstablishmentNumbersIncludingGB Pass",
      "inputs": {
        "fileName": "differentcountryestablishmentnumbersincludinggb-pass.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "approved",
        "reasonsForFailure": null,
        "model": "SAVERS2"
      }
    },
    {
      "testName": "Empty RMS Fail",
      "inputs": {
        "fileName": "empty-rms-fail.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "rejected_other",
        "reasonsForFailure": "Check GB Establishment RMS Number.",
        "model": "NOREMOS"
      }
    },
    {
      "testName": "InvalidEstablishmentFormats Fail",
      "inputs": {
        "fileName": "invalidestablishmentformats-fail.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "rejected_other",
        "reasonsForFailure": "Check GB Establishment RMS Number.",
        "model": "NOREMOS"
      }
    },
    {
      "testName": "InvalidFormat RmsGb 000000 000 Unparse",
      "inputs": {
        "fileName": "invalidformat-rmsgb-000000-000-unparse.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "rejected_other",
        "reasonsForFailure": null,
        "model": "NOMATCH"
      }
    },
    {
      "testName": "Multipledifferent Establishment Numbers Fail",
      "inputs": {
        "fileName": "multipledifferent-establishment-numbers-fail.csv",
        "applicationId": "REPLACE_ME"
      },
      "expectedResults": {
        "approvalStatus": "rejected_other",
        "reasonsForFailure": "Multiple GB Place of Dispatch (Establishment) numbers found on packing list.\n",
        "model": "SAVERS2"
      }
    }
  ]
}
