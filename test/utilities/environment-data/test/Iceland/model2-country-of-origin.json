        "applicationId": "1816178345260"
      },
      "expectedResults": {
        "approvalStatus": "approved",
        "reasonsForFailure": null,
        "model": "ICELAND2"
      }
    },
    {
      "testName": "ac2 Null NIRMS Fail",
      "inputs": {
